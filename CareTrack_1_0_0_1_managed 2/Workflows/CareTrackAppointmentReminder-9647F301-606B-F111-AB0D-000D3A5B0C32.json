{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_0e49a"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_c9b35"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "2026-06-19T05:00:00Z"
          },
          "metadata": {
            "operationMetadataId": "a25ec1e3-db04-4619-8b71-90f9988e09cb"
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "List_rows": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "a21df544-f51b-400f-a140-30e7fd13876f"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "new_appointments",
              "$filter": "@concat('new_status eq 100000000 and new_appointmentdatetime1 ge ', formatDateTime(addDays(utcNow(), 1), 'yyyy-MM-dd'), 'T00:00:00Z')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps"
            }
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_rows')?['body/value']",
          "actions": {
            "Get_a_row_by_ID": {
              "metadata": {
                "operationMetadataId": "005c2a78-ccf4-47c6-895c-1cf9163f15bd"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "new_patients",
                  "recordId": "@items('Apply_to_each')?['_new_patientid_value']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Send_an_email_(V2)": {
              "runAfter": {
                "Get_a_row_by_ID": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "12b69444-1488-4482-982f-c0b73bcb0eeb"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('Get_a_row_by_ID')?['body/new_email']",
                  "emailMessage/Subject": "CareTrack – Reminder: Your Appointment Tomorrow",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dear @{outputs('Get_a_row_by_ID')?['body/new_patientname']},<br><br>You have an appointment tomorrow.<br><br>Date:@{formatDateTime(items('Apply_to_each')?['new_appointmentdatetime1'], 'dd/MM/yyyy hh:mm tt')}<br><br>Please arrive 10 minutes early.<br><br>Regards,<br>CareTrack Hospital Management</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            }
          },
          "runAfter": {
            "List_rows": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "38d2e5f8-eb5f-4386-bc41-f8a65fe685c7"
          },
          "type": "Foreach"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}