              "emailMessage/Subject": "CareTrack – Corporate Wellness Enquiry Received",
              "emailMessage/Body": "<p>Dear @{triggerOutputs()?['body/new_hrcontactname']},<br>\n<br>\nThank you for your interest in CareTrack Corporate Wellness Packages.<br>\n<br>\nWe have received your enquiry for @{triggerOutputs()?['body/new_companyname']} and our team will<br>\nreview your requirements and contact you within 48 hours.<br>\n<br>\nYour Enquiry Summary:<br>\nCompany: @{triggerOutputs()?['body/new_companyname']}<br>\nIndustry: @{triggerOutputs()?['body/new_industry']}<br>\nNumber of Employees: @{triggerOutputs()?['body/new_numberofenrolledemployees']}<br>\nInterested Package: @{triggerBody()?['_new_packagetype_label']}<br>\n<br>\nRegards,<br>\nCareTrack Corporate Wellness Team</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      }
