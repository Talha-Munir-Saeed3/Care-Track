{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_c9b35"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_0e49a"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "822ade2a-ae97-4c8f-a5af-a62d9af5cde7"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "new_corporateaccount",
              "subscriptionRequest/scope": 4
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Condition": {
          "actions": {
            "Send_an_email_(V2)": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "3159b87d-76a4-4656-ac7b-fff640dcae12"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@triggerOutputs()?['body/new_hrcontactemail']",
                  "emailMessage/Subject": "CareTrack – Your Corporate Wellness Package is Now Active",
                  "emailMessage/Body": "<p>Dear @{triggerOutputs()?['body/new_hrcontactname']},<br>\n<br>\nYour CareTrack Corporate Wellness Package for @{triggerOutputs()?['body/new_companyname']} has been activated.<br>\n<br>\nPackage Type: @{triggerBody()?['_new_packagetype_label']}<br>\nNext Steps:<br>\n1. Send your employee list to admin@caretrack.com<br>\n2. Employees will be enrolled within 24 hours<br>\n<br>\nWelcome to CareTrack Corporate Wellness!<br>\n<br>\nRegards,<br>\nCareTrack Corporate Wellness Team</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {},
          "expression": {
            "and": [
              {
                "equals": [
                  "@int(triggerBody()?['new_isactive'])",
                  0
                ]
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "34ed55e4-5032-451d-91cc-534d8c1f63b9"
          },
          "type": "If"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}