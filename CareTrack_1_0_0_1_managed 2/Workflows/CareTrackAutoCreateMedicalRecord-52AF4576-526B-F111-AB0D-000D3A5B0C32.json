          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "1e277649-2510-40dd-aedc-943796a7f0df"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "new_appointment",
              "subscriptionRequest/scope": 4
            },
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            }
          }
        }
      },
      "actions": {
        "Condition": {
          "actions": {
            "Add_a_new_row": {
              "runAfter": {
                "Get_a_row_by_ID": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "ad628569-b12f-49a3-ab9d-4c76e43c8807"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "new_medicalrecords",
                  "item/new_AppointmentID@odata.bind": "@concat('/new_appointments(', triggerBody()?['new_appointmentid'], ')')",
                  "item/new_PatientID@odata.bind": "@concat('/new_patients(', triggerBody()?['_new_patientid_value'], ')')",
                  "item/new_dateofvisit": "@outputs('Get_a_row_by_ID')?['body/new_appointmentdatetime1']",
                  "item/new_Doctor@odata.bind": "@concat('/new_doctors(', triggerBody()?['_new_doctorid_value'], ')')"
                },
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                }
              }
            },
            "Get_a_row_by_ID": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "3d1966bf-c5c4-4089-91cb-fd91528c5329"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "new_appointments",
                  "recordId": "@triggerBody()?['new_appointmentid']"
                },
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                }
              }
            }
          },
          "runAfter": {},
          "expression": {
            "and": [
              {
                "equals": [
                  "@int(triggerBody()?['new_status'])",
                  100000001
                ]
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "53feaa96-d5aa-4e4f-abde-83171d1fa0bb"
          },
          "type": "If"
        }
      }
