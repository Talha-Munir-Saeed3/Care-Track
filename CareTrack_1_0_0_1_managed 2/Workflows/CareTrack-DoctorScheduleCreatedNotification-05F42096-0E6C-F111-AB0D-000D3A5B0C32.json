{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_0e49a"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_c9b35"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "4872ab1e-ceaf-400e-84d2-01a1aac5f732"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "new_doctorschedule",
              "subscriptionRequest/scope": 4
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_Doctor_Details": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "e406be16-4d58-4217-ae50-def312916afd"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "new_doctors",
              "recordId": "@triggerOutputs()?['body/_new_doctor_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "List_rows": {
          "runAfter": {
            "Get_Doctor_Details": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "18f87598-332f-44c9-98d0-42aff74a344c"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "new_doctorschedules",
              "$filter": "_new_doctor_value eq '@{triggerOutputs()?['body/_new_doctor_value']}'"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select": {
          "runAfter": {
            "List_rows": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4fc4c5b5-2c13-4dc9-b590-7c007dbda13e"
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('List_rows')?['body/value']",
            "select": {
              "Schedule": "@concat(item()?['new_dayofweek@OData.Community.Display.V1.FormattedValue'], ' | ', item()?['new_StartTime'], ' - ', item()?['new_EndTime'])"
            }
          }
        },
        "Join": {
          "runAfter": {
            "Select": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "d85cba42-c527-4912-9eaa-77720efe9ec6"
          },
          "type": "Join",
          "inputs": {
            "from": "@body('Select')",
            "joinWith": "<br>"
          }
        },
        "List_rows_1": {
          "runAfter": {
            "Join": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "2ba8047c-9d60-418e-ae33-de3bf8e02295"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "new_doctors",
              "$select": "new_email,new_doctorname,new_doctorid",
              "$filter": "_new_department_value eq '@{outputs('Get_Doctor_Details')?['body/_new_department_value']}' and new_doctorid ne '@{triggerOutputs()?['body/_new_doctor_value']}'"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_rows_1')?['body/value']",
          "actions": {
            "Send_an_email_(V2)": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "ebf740d7-b4a4-45db-9e2a-247acd928b74"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@items('Apply_to_each')?['new_email']",
                  "emailMessage/Subject": "Doctor Schedule Update",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dr. @{outputs('Get_Doctor_Details')?['body/new_doctorname']} has joined your department and their schedule is now available.<br><br>📅 Schedule:<br>@{body('Join')}<br><br>Please coordinate accordingly.<br>CareTrack Team</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "List_rows_1": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a58579cc-843f-405b-9b87-c5f37641fc27"
          },
          "type": "Foreach"
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}