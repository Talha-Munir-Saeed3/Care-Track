{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_0e49a"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_c9b35"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "new_appointment",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "new_status"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            }
          }
        }
      },
      "actions": {
        "Condition": {
          "actions": {
            "Get_a_row_by_ID": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "new_doctors",
                  "recordId": "@triggerOutputs()?['body/_new_doctorid_value']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Get_a_row_by_ID_1": {
              "runAfter": {
                "Get_a_row_by_ID": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "new_patients",
                  "recordId": "@triggerOutputs()?['body/_new_patientid_value']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Send_an_email_(V2)": {
              "runAfter": {
                "Get_a_row_by_ID_1": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('Get_a_row_by_ID')?['body/new_email']",
                  "emailMessage/Subject": "CareTrack — Appointment Cancelled: @{outputs('Get_a_row_by_ID_1')?['body/new_patientname']}",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Your appointment with @{outputs('Get_a_row_by_ID_1')?['body/new_patientname']} on @{formatDateTime(triggerOutputs()?['body/new_appointmentdatetime1'], 'dddd, MMMM d, yyyy')} at @{formatDateTime(triggerOutputs()?['body/new_appointmentdatetime1'], 'h:mm tt')} has been cancelled. Your schedule has been updated.</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            },
            "Send_an_email_(V2)_1": {
              "runAfter": {
                "Send_an_email_(V2)": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('Get_a_row_by_ID_1')?['body/new_email']",
                  "emailMessage/Subject": "CareTrack — Your Appointment Has Been Cancelled",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Your appointment with @{outputs('Get_a_row_by_ID')?['body/new_doctorname']} on @{formatDateTime(triggerOutputs()?['body/new_appointmentdatetime1'], 'dddd, MMMM d, yyyy')} at @{formatDateTime(triggerOutputs()?['body/new_appointmentdatetime1'], 'h:mm tt')} has been cancelled. If this was a mistake or you'd like to rebook, please visit the CareTrack Patient Portal.</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            }
          },
          "runAfter": {},
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerOutputs()?['body/new_status']",
                  100000002
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}